#!name=脚本探针 Surge 版
#!desc=诊断用：同一份 probe.js，在 Surge 里拦截 example.com/probe-test

[Script]
探针B-https = type=http-request, pattern=^https://example\.com/probe-test, script-path=https://raw.githubusercontent.com/xx123456789xx/Script-Hub/main/probe/probe.js, requires-body=0, timeout=10
探针B-http = type=http-request, pattern=^http://example\.com/probe-test, script-path=https://raw.githubusercontent.com/xx123456789xx/Script-Hub/main/probe/probe.js, requires-body=0, timeout=10
探针A = type=http-request, pattern=^https://youtubei\.googleapis\.com/youtubei/v1/log_event, script-path=https://raw.githubusercontent.com/xx123456789xx/Script-Hub/main/probe/probe.js, requires-body=0, timeout=10

[MITM]
hostname = %APPEND% example.com, youtubei.googleapis.com
